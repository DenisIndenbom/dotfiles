# --- MODIFIER ---
set $mod  Mod4
set $term ~/.config/scripts/utilities/terminal.sh

# --- AUTOSTART ---
exec ~/.config/scripts/system/autostart.sh
#exec Telegram -autostart

# --- APPEARANCE ---
font pango:monospace 8

# Gaps
gaps inner 4
gaps outer 4
smart_gaps off

# Borders
default_border pixel 0
for_window [tiling]   border pixel 2
for_window [floating] border pixel 2
smart_borders on

# Color Scheme (Catppuccin)
client.focused          #cad3f5 #cad3f5 #cad3f5 #cad3f5
client.focused_inactive #24273a #24273a #24273a #24273a
client.unfocused        #24273a #24273a #24273a #24273a
client.urgent           #E78284 #E78284 #E78284 #E78284
client.placeholder      #24273a #24273a #24273a #24273a

# --- INPUT ---
input type:keyboard {
    xkb_layout "us,ru"
    xkb_options "grp:alt_shift_toggle"
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
}
seat seat0 xcursor_theme Adwaita 32

# --- OUTPUT --
#output eDP scale 1.2

# --- SWAYFX EFFECTS ---
# Blur
blur enable
blur_xray disable
blur_passes 5
blur_radius 6

# Rounded corners
corner_radius 12

# Dim unfocused windows
default_dim_inactive 0.0

# Animations
animation_duration_ms 250

# Layer effects
layer_effects "waybar" {
    blur enable
    blur_ignore_transparent enable
    opacity 0.90
    corner_radius 0
}
layer_effects "rofi" {
    blur enable
    blur_ignore_transparent enable
    opacity 0.90
    corner_radius 0
}
layer_effects "dunst" {
    blur enable
    blur_ignore_transparent enable
    opacity 0.90
    corner_radius 0
}
layer_effects "gtk-layer-shell" {
    blur enable
    blur_ignore_transparent enable
    opacity 0.90
    corner_radius 12
}

# --- WINDOW RULES ---
for_window [app_id="(?i).*floating.*"] floating enable
for_window [app_id="(?i).*fullscreen.*"] fullscreen enable
for_window [app_id="(?i).*scratchpad.*"] move scratchpad

# KeePassXC
for_window [app_id="KeePassXC"] floating enable
for_window [app_id="KeePassXC"] resize set 1200 800
for_window [app_id="KeePassXC"] move position center

for_window [app_id="Alacritty"] opacity 0.90
for_window [app_id="Alacritty"] blur enable

for_window [app_id="Thunar"] opacity 0.90
for_window [app_id="Thunar"] blur enable

for_window [app_id="Yad"] opacity 0.90
for_window [app_id="Yad"] blur enable

for_window [app_id="Rofi"] opacity 0.90
for_window [app_id="Rofi"] blur enable

for_window [app_id="Dunst"] opacity 0.90
for_window [app_id="Dunst"] blur enable

# The following lines were removed because "fullscreen" is not a valid criterion.
# for_window [fullscreen] blur disable
# for_window [fullscreen] corner_radius 0

# --- WINDOW MANAGEMENT ---
floating_modifier $mod
tiling_drag enable

# --- TERMINAL ---
bindsym $mod+Return         exec $term
bindsym $mod+Shift+Return   exec $term --float

# --- MENUS ---
bindsym $mod+d         exec ~/.config/scripts/menu/launcher.sh
bindsym $mod+p         exec ~/.config/scripts/menu/power.sh
bindsym $mod+m         exec ~/.config/scripts/menu/player.sh
bindsym $mod+Shift+n   exec ~/.config/scripts/menu/network.sh
bindsym $mod+Shift+b   exec ~/.config/scripts/menu/bluetooth.sh
bindsym $mod+Shift+m   exec ~/.config/scripts/menu/sound.sh
bindsym $mod+Shift+w   exec ~/.config/scripts/menu/wallpaper.sh
bindsym $mod+Print     exec ~/.config/scripts/utilities/screenshot.sh --menu

# --- APPS ---
bindsym $mod+k exec keepassxc
bindsym $mod+r exec $term -e ranger

# --- UTILITIES ---
bindsym $mod+l exec ~/.config/scripts/utilities/lockscreen.sh

# --- SCREENSHOTS ---
bindsym $mod+Shift+s   exec ~/.config/scripts/utilities/screenshot.sh --area
bindsym Print          exec ~/.config/scripts/utilities/screenshot.sh --shot

# --- BRIGHTNESS & VOLUME --
bindsym XF86MonBrightnessUp   exec ~/.config/scripts/utilities/brightness.sh --up
bindsym XF86MonBrightnessDown exec ~/.config/scripts/utilities/brightness.sh --down

bindsym XF86AudioRaiseVolume  exec ~/.config/scripts/utilities/volume.sh --up
bindsym XF86AudioLowerVolume  exec ~/.config/scripts/utilities/volume.sh --down
bindsym XF86AudioMute         exec ~/.config/scripts/utilities/volume.sh --mute

# --- MEDIA CONTROLS ---
set $players spotify,%any,firefox,chromium,brave,mpd
bindsym XF86AudioNext exec playerctl -p $players next
bindsym XF86AudioPrev exec playerctl -p $players previous
bindsym XF86AudioPlay exec playerctl -p $players play-pause
bindsym XF86AudioStop exec playerctl -a stop

# --- BASIC KEYBINDINGS ---
bindsym $mod+Shift+q kill

# Focus movement
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Window movement
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Layout controls
bindsym $mod+v split toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Floating & focus toggles
bindsym $mod+space       floating toggle
bindsym $mod+Shift+space focus mode_toggle

# --- WORKSPACES ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Workspace switching
bindsym $mod+1  workspace number $ws1
bindsym $mod+2  workspace number $ws2
bindsym $mod+3  workspace number $ws3
bindsym $mod+4  workspace number $ws4
bindsym $mod+5  workspace number $ws5
bindsym $mod+6  workspace number $ws6
bindsym $mod+7  workspace number $ws7
bindsym $mod+8  workspace number $ws8
bindsym $mod+9  workspace number $ws9
bindsym $mod+0  workspace number $ws10

# Move containers between workspaces
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Move the focused workspace to the right/left monitor
bindsym $mod+Ctrl+Right move workspace to output right
bindsym $mod+Ctrl+Left  move workspace to output left

# --- SYSTEM CONTROLS ---
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart