[global]
  monitor = 0
  follow = mouse

  width = (256, 300)
  height = (0, 256)
  offset = (15, 45)
  origin = top-right
  padding = 20
  horizontal_padding = 20

  frame_width = 2
  frame_color = "#b4befe"
  separator_height = 2
  separator_color = "#313244"
  corner_radius = 20

  font = JetBrains Mono 10
  markup = full
  format = "<b>%s</b>\n%b"
  alignment = left
  word_wrap = yes
  ignore_newline = no
  show_age_threshold = 60

  icon_position = left
  min_icon_size = 48
  max_icon_size = 48

  sort = no
  stack_duplicates = true
  hide_duplicate_count = no
  show_indicators = no
  sticky_history = no
  history_length = 6

  mouse_left_click = do_action, close_current
  mouse_middle_click = context, close_current
  mouse_right_click = close_all

  progress_bar = true
  progress_bar_frame_width = 1
  progress_bar_min_width = 150
  progress_bar_max_width = 280
  progress_bar_corner_radius = 5

  dmenu = /usr/bin/rofi -dmenu -theme "$HOME/.config/rofi/dmenu.rasi" -p 
  browser = /usr/bin/xdg-open

[urgency_low]
  background = "#1e1e2e"
  foreground = "#cdd6f4"
  frame_color = "#b4befe"
  highlight = "#b4befe"
  timeout = 2

[urgency_normal]
  background = "#1e1e2e"
  foreground = "#cdd6f4"
  frame_color = "#b4befe"
  highlight = "#b4befe"
  timeout = 5

[urgency_critical]
  background = "#1e1e2e"
  foreground = "#cdd6f4"
  frame_color = "#f38ba8"
  highlight = "#f38ba8"
  timeout = 10
