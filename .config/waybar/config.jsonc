{
  "layer": "top",
  "position": "top",
  "height": 35,
  "spacing": 1,
  "margin": 0,
  "exclusive": true,
  "passthrough": false,
  "ipc": true,

  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "network",
    "bluetooth",
    "wireplumber#sink",
    "battery",
    "sway/language",
    "custom/power",
    "custom/sep"
  ],

  "sway/workspaces": {
    "all-outputs": false,
    "disable-scroll": false,
    "format": "{value}"
  },

  "clock": {
    "interval": 1,
    "format": "  {:%a %b %d  |  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#fab387'><b>{}</b></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#cba6f7'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "tray": {
    "icon-size": 19,
    "spacing": 8
  },

  "network": {
    "interface": "wlp1s0",
    "interval": 2,
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈁 {ipaddr}",
    "format-disconnected": "󰤭 Offline",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
	  "on-click": "~/.config/scripts/menu/network.sh"
  },

  "bluetooth": {
    "format-disabled": "",
	  "format-off": "󰂲",
	  "format-on" : "",
    "format-connected": "󰂱 {device_alias}",
    "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
	  "tooltip-format-enumerate-connected-battery": "{device_alias}\t󰁹{device_battery_percentage}%",
	  "on-click" : "~/.config/scripts/menu/bluetooth.sh"
  },

  "wireplumber#sink": {
    "format": "{icon} {volume}%",
    "format-muted": " Mute",
    "format-icons": ["", "", "", ""],
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "~/.config/scripts/menu/sound.sh"
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "ACAD",
    "interval": 2,
    "states": {
      "low": 50,
      "warning": 20,
      "critical": 10
    },
    "full-at": 99,
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-full": "{icon} {capacity}%",
    "format-icons": {
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "full": "󰁹"
	  },
    "tooltip-format": "{timeTo}"
  },

  "sway/language": {
    "format": " {short}",
    "tooltip-format": "{long}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/scripts/menu/power.sh"
  },

  "custom/sep": {
    "format": " ",
    "tooltip": false
  }
}